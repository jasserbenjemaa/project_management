
generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}
model User {
  id              String       @id @default(uuid())
  name            String       @unique
  email           String       @unique
  password        String
  role            Role
  artifact_type   Artifact?
  seniority_level Level?
  // Set once, at creation. Never changed by updateUser — see users.ts.
  hiredAt         DateTime?
  assignmentsMade Assignment[] @relation("AssignedBy")
  assignments     Assignment[] @relation("AssignedUser")
  timeEntries     TimeEntry[]
  manager         User?        @relation("ReportsTo", fields: [managerId], references: [id])
  managerId       String?
  reports         User[]       @relation("ReportsTo")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  tasksAsLLRAuthor Task[] @relation("TaskLLRAuthor")
  tasksAsLLTAuthor Task[] @relation("TaskLLTAuthor")
}
model Sheet {
  id        String    @id @default(cuid())
  name      String    @default("Untitled Sheet")
  kind      SheetKind @default(PROGRESS)
  columns   Json
  rows      Json
  projectId String?
  project   Project?  @relation(fields: [projectId], references: [id],onDelete: SetNull)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // A project can have at most one sheet of each kind — one Progress
  // sheet, one ITS sheet, one IQA sheet — not one sheet total.
  // (projectId alone is no longer @unique; NULL projectId rows, i.e.
  // manually-created sheets, are unaffected since Postgres never treats
  // NULLs as colliding in a unique index.)
  @@unique([projectId, kind])
}
model Project {
  id           String        @id @default(uuid())
  name         String
  status       ProjectStatus @default(PLANNED)
  deliveryDate DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  assignments  Assignment[]
  tasks        Task[]
  // One Progress sheet + one ITS sheet + one IQA sheet per project,
  // enforced by Sheet's @@unique([projectId, kind]) — not a plain 1:1.
  sheets       Sheet[]
}

model Task {
  id            String      @id @default(uuid())
  title         String
  status        TaskStatus  @default(IN_PROGRESS)
  projectId     String
  estimatedDays Float?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  project       Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  timeEntries   TimeEntry[]

  // Stable link to the sheet row this Task was synced from (row.__rowId,
  // see sheet-table.tsx). functionName can repeat within a project (or be
  // edited later), so it's no longer the key — just kept for display.
  sheetRowId    String?
  functionName  String?
  llrId         String?
  fileC         String?
  codeVersion   String?
  complexity    Int?
  its           String?
  iqa           String?

  assigneeLLRId String?
  assigneeLLR   User?       @relation("TaskLLRAuthor", fields: [assigneeLLRId], references: [id], onDelete: SetNull)
  assigneeLLTId String?
  assigneeLLT   User?       @relation("TaskLLTAuthor", fields: [assigneeLLTId], references: [id], onDelete: SetNull)

  @@unique([projectId, sheetRowId])
}

model TimeEntry {
  id        String   @id @default(uuid())
  userId    String
  taskId    String
  days      Float
  loggedAt  DateTime @default(now())
  note      String?
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])
}

model Assignment {
  id            String    @id @default(uuid())
  userId        String?
  projectId     String?
  assignedById  String?
  roleOnProject String
  startDate     DateTime
  endDate       DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Snapshots — populated at creation, survive User/Project deletion
  userName      String
  userEmail     String
  projectName   String

  user          User?     @relation("AssignedUser", fields: [userId], references: [id], onDelete: SetNull)
  assignedBy    User?     @relation("AssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)
  project       Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@unique([userId, projectId])
}


enum Role {
  UNIT_MANAGER
  ENGAGEMENT_MANAGER
  CONSULTANT
}

enum ProjectStatus {
  PLANNED
  ACTIVE
  ON_HOLD
  COMPLETED
}



enum Artifact {
  HLT
  LLT
  LLR
  CODE_REVIEW
  ARCHITECTURE
  }

enum Level {
  JUNIOR
  MID
  SENIOR
  EXPERT
}
enum TaskStatus {
  IN_PROGRESS
  READY_FOR_DRY_RUN
  DRY_RUN_IN_PROGRESS
  READY_FOR_TC
  TC_DONE
  TC_CORRECTION
  READY_FOR_QC
  READY_FOR_DELIVERY
  DELIVERED
  OUT_OF_SCOPE
  BLOCKED
}

enum SheetKind {
  PROGRESS
  ITS
  IQA
}


